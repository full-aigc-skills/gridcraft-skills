{
  "schema": "craft-scenario-playbooks/v1",
  "application": "gridcraft",
  "id": "reconcile-data",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "读取本方主键与金额",
      "command": "sheet.read",
      "params": {
        "range": "A1:D100",
        "formulas": true
      }
    },
    {
      "purpose": "实际读取对方工作表字段和主键范围，不凭名称假设结构",
      "command": "sheet.read",
      "params": {
        "sheet": "Sheet2",
        "range": "A1:B100",
        "formulas": true
      }
    },
    {
      "purpose": "先检查主键缺失/重复，唯一匹配才提取金额",
      "command": "cell.set",
      "params": {
        "cell": "E2",
        "input": "=IF(A2=\"\",IF(B2=\"\",\"\",\"缺少主键\"),IF(COUNTIF(Sheet2!$A$2:$A$100,A2)=0,\"未匹配\",IF(COUNTIF(Sheet2!$A$2:$A$100,A2)=1,VLOOKUP(A2,Sheet2!$A$2:$B$100,2,FALSE),\"重复键\")))"
      }
    },
    {
      "purpose": "在新列计算金额差额",
      "command": "cell.set",
      "params": {
        "cell": "F2",
        "input": "=IF(AND(ISNUMBER(B2),ISNUMBER(E2)),B2-E2,\"\")"
      }
    },
    {
      "purpose": "按实际末行替换100，填充每行且固定对方数据范围",
      "command": "edit.fillDown",
      "params": {
        "range": "E2:F100"
      }
    },
    {
      "purpose": "检查计算结果",
      "command": "sheet.read",
      "params": {
        "range": "A2:F10"
      }
    }
  ],
  "check": "分别列出缺失、多对一和金额差异，不通过删除未匹配行让总数相等。",
  "boundary": "工作表名、键列和重复键必须先查；VLOOKUP只取首条，不适合未处理的多对多。 当前示例先COUNTIF分流重复键，不使用IFERROR把重复键隐藏成首条金额。示例100替换为真实范围，双方原始键/金额及所有未匹配行保留。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
