{
  "schema": "craft-scenario-playbooks/v1",
  "application": "gridcraft",
  "id": "reconcile-data",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "读取双方主键与金额",
      "command": "sheet.read",
      "params": {
        "range": "A1:D100",
        "formulas": true
      }
    },
    {
      "purpose": "在新列查找匹配记录",
      "command": "cell.set",
      "params": {
        "cell": "E2",
        "input": "=IFERROR(VLOOKUP(A2,Sheet2!A:B,2,FALSE),\"未匹配\")"
      }
    },
    {
      "purpose": "在新列计算金额差额",
      "command": "cell.set",
      "params": {
        "cell": "F2",
        "input": "=IF(ISNUMBER(E2),B2-E2,\"\")"
      }
    },
    {
      "purpose": "检查计算结果",
      "command": "sheet.read",
      "params": {
        "range": "A2:F10"
      }
    }
  ],
  "check": "分别列出缺失、多对一和金额差异，不通过删除未匹配行让总数相等。",
  "boundary": "工作表名、键列和重复键必须先查；VLOOKUP只取首条，不适合未处理的多对多。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
